{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FoldBOcean Settings",
  "version": "0.1.0",
  "identifier": "com.spiderweb.settings",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FoldBOcean — Настройки",
        "width": 1280,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 640,
        "backgroundColor": "#1e1e20"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": false
  }
}
